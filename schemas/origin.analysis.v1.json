        "generated_at",
        "analysis_code_version",
        "analysis_code_sha256",
        "dependencies",
        "model_config_sha256",
        "tensor_sha256",
        "checksum_definition",
        "index_base",
        "rounding_decimals",
        "validation",
        "model_license"
