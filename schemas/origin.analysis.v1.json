        "layer",
        "hook",
        "location",
        "tensor_shape",
        "l2",
        "rms"
      ],
      "title": "Activation",
      "type": "object"
    },
    "Architecture": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "const": "GPT-2 decoder-only, pre-LayerNorm",
          "title": "Family",
          "type": "string"
        },
        "representation": {
          "const": "semantic component schematic",
          "title": "Representation",
          "type": "string"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/Component"
          },
          "title": "Components",
          "type": "array"
        },
        "connections": {
          "items": {
            "$ref": "#/$defs/Connection"
          },
          "title": "Connections",
          "type": "array"
        }
      },
      "required": [
        "family",
        "representation",
        "components",
        "connections"
      ],
      "title": "Architecture",
      "type": "object"
    },
    "Attention": {
      "additionalProperties": false,
      "properties": {
        "axes": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "const": "layer",
              "type": "string"
            },
            {
              "const": "head",
              "type": "string"
            },
            {
              "const": "query",
              "type": "string"
            },
            {
              "const": "key",
              "type": "string"
            }
          ],
          "title": "Axes",
          "type": "array"
        },
        "shape": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Shape",
          "type": "array"
        },
        "values": {
          "items": {
            "items": {
              "items": {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              "type": "array"
            },
            "type": "array"
          },
          "title": "Values",
          "type": "array"
        },
        "hooks": {
          "items": {
            "type": "string"
          },
          "title": "Hooks",
          "type": "array"
        },
        "precision": {
          "const": "float32, rounded to 8 decimal places",
          "title": "Precision",
          "type": "string"
        },
        "causal": {
          "const": true,
          "title": "Causal",
          "type": "boolean"
        }
      },
      "required": [
        "axes",
        "shape",
        "values",
        "hooks",
        "precision",
        "causal"
      ],
      "title": "Attention",
      "type": "object"
