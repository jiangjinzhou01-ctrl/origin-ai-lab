          "title": "Text",
          "type": "string"
        },
        "display": {
          "title": "Display",
          "type": "string"
        },
        "logit": {
          "title": "Logit",
          "type": "number"
        },
        "probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Probability",
          "type": "number"
