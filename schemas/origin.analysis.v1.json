        "backend",
        "device",
        "dtype",
        "eval_mode",
        "inference_mode",
        "attention_implementation",
        "max_tokens",
        "cpu_threads",
        "model_load_ms",
        "inference_ms",
        "serialization_ms",
        "process_rss_mb",
        "cache_hit"
