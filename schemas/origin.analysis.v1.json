            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Tensor Shape",
          "type": "array"
        },
        "l2": {
          "items": {
            "type": "number"
          },
          "title": "L2",
          "type": "array"
