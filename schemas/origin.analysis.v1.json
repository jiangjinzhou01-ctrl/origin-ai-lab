        "tensor_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Tensor Sha256",
          "type": "string"
        },
        "checksum_definition": {
          "const": "SHA256 of little-endian float32 attention, raw logits, and cached residuals in hook order",
