# Frontend: copy to apps/web/.env.local when needed. Static mode needs no API.
VITE_API_URL=http://127.0.0.1:8000
# Python API: explicitly allow the frontend origin. Never use a wildcard in production.
ORIGIN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ORIGIN_DEVICE=cpu
ORIGIN_MAX_TOKENS=64
ORIGIN_CPU_THREADS=2
ORIGIN_RATE_LIMIT=12
