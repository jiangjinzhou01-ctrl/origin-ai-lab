          "type": "string"
        },
        "index_base": {
          "const": 0,
          "title": "Index Base",
          "type": "integer"
        },
        "rounding_decimals": {
          "const": 8,
          "title": "Rounding Decimals",
          "type": "integer"
        },
        "validation": {
          "const": "schema + finite + shape + normalization + causal mask + byte reconstruction",
          "title": "Validation",
          "type": "string"
        },
        "model_license": {
          "const": "MIT",
          "title": "Model License",
          "type": "string"
        }
